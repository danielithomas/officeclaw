# Outclaw Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# REQUIRED: Azure App Registration
# ============================================

# Your Azure app's Application (client) ID
# Get from: Azure Portal > App registrations > Your app > Overview
# Optional — OfficeClaw ships with a default app registration.
# Set this only if you want to use your own Azure app.
# OFFICECLAW_CLIENT_ID=

# ============================================
# OPTIONAL: Client Secret (legacy mode)
# ============================================

# If set, Outclaw uses Confidential Client with authorization code flow.
# If NOT set (recommended), Outclaw uses Public Client with device code flow.
#
# For device code flow, you must enable "Allow public client flows" in Azure:
#   Azure Portal > App registrations > Your app > Authentication > Advanced settings
#   > Allow public client flows > Yes
#
# OFFICECLAW_CLIENT_SECRET=

# ============================================
# OPTIONAL: Defaults work for most users
# ============================================

# Redirect URI - only needed for confidential client (authorization code) flow
# Default: http://localhost:8000/callback
# OFFICECLAW_REDIRECT_URI=http://localhost:8000/callback

# Tenant ID
# "consumers" = personal Microsoft accounts (Outlook.com, Hotmail, Live)
# "common" = personal + work/school accounts
# Default: consumers
# OFFICECLAW_TENANT_ID=consumers

# API Scopes (space-separated)
# Default: Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite Tasks.ReadWrite
# OFFICECLAW_SCOPES=Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite Tasks.ReadWrite

# ============================================
# ADVANCED: Usually don't need to change
# ============================================

# Graph API endpoint
# OFFICECLAW_GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# Token storage directory (relative to home)
# OFFICECLAW_TOKEN_CACHE_DIR=.officeclaw

# Use system keyring for token storage (true/false) - confidential client only
# OFFICECLAW_USE_KEYRING=true

# Token refresh threshold (seconds before expiry) - confidential client only
# OFFICECLAW_TOKEN_REFRESH_THRESHOLD=300

# Request timeout (seconds)
# OFFICECLAW_REQUEST_TIMEOUT=30

# Max retries for failed requests
# OFFICECLAW_MAX_RETRIES=3

# ============================================
# CAPABILITY GATES (Safety)
# ============================================
# Write operations are disabled by default.
# Enable only what you need.

# Allow sending emails (send, reply, forward)
# OFFICECLAW_ENABLE_SEND=true

# Allow deleting items (mail, calendar events, tasks)
# OFFICECLAW_ENABLE_DELETE=true

# Recipient allowlist for outbound email (comma-separated).
# When set, send, reply, reply-all and forward are all restricted to these
# addresses — blocked attempts are logged to
# ~/.openclaw/workspace/automation/logs/email-blocked.log.
# When unset, any address may be mailed.
# OFFICECLAW_ALLOWED_RECIPIENTS=alice@example.com,bob@example.com

# Where `mail attachments download` saves files when --dest is not given.
# Default: officeclaw_downloads/ inside the first allowed attachment directory
# below, or inside your platform's Downloads folder if no allowlist is set
# (~/Downloads on macOS, the XDG download directory on Linux, the Downloads
# known folder on Windows).
# OFFICECLAW_DOWNLOADS_DIR=~/.openclaw/workspace/wip/downloads

# Directories that attachments may be read from (comma-separated).
# When set, `mail send --attachment` refuses files outside these directories;
# symlinks are resolved first. When unset, any readable file may be attached.
# A dedicated drop directory is the recommended pattern.
# OFFICECLAW_ALLOWED_ATTACHMENT_DIRS=~/.openclaw/workspace/wip

# NOTE ON PRECEDENCE
# Ordinary settings here override the process environment. Security settings
# (gates, allowlists, size limits) compose with it to the stricter value, so
# this file can tighten what a supervising process allows but never widen it.
# Anything dropped is reported with a warning when the command runs.

# ============================================
# TIMEZONE
# ============================================
# Used when deciding what "today" means for `tasks list --overdue`.
# Microsoft To Do due dates carry no timezone, so this is compared against the
# date where you are. Defaults to the system timezone.
# OFFICECLAW_TIMEZONE=Australia/Melbourne

# ============================================
# TASK DEFAULTS
# ============================================
# Used when a task command is given neither --list-id nor --list-name.
# With neither set, the account's built-in Tasks list is used.
# OFFICECLAW_DEFAULT_TASK_LIST_NAME=Tasks
# OFFICECLAW_DEFAULT_TASK_LIST_ID=

# ============================================
# CONFIG FILE
# ============================================
# Optional preferences file (default: ~/.config/officeclaw/config.toml).
# Conveniences only — capability gates and allowlists are ignored there.
# OFFICECLAW_CONFIG=~/.config/officeclaw/config.toml
